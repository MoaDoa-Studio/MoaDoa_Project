  m_text: "\uC774\uACF3\uC5D0\uB294 \uC5F0\uAD6C \uB0B4\uC6A9\uC774 \uC801\uD790
    \uC608\uC815\uC785\uB2C8\uB2E4. \uAD6C\uCCB4\uC801\uC73C\uB85C \uC5B4\uB5A4 \uB0B4\uC6A9\uC774\n\uB4E4\uC5B4\uAC00\uAC8C
    \uB420\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC \uBE44\uC8FC\uC5BC \uD655\uC778\uC744
    \uC704\uD574\uC11C \uC784\uC758\uB85C \uD14D\uC2A4\uD2B8\uB97C \uC791\uC131\uD558\uC600\uC2B5\uB2C8\uB2E4.
    \uAE30\uD68D\uC11C\uB97C \uBCF4\uB2C8 \uC774 \uACF5\uAC04\uC5D0\uB294 \uAF64
    \uAE34 \uC124\uBA85\uAE00\uC774 \uC791\uC131 \uB420 \uC218 \uC788\uC5B4\uC57C
    \uD558\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \uC5F0\uAD6C\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\uC5F0\uAD6C\uAC00
